# ========================================
# AegisVault - Git Ignore Configuration
# ========================================

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Python environments
.venv/
venv/
env/
ENV/

# Python generated files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Private application data
storage/*
!storage/.gitkeep

# Backups
backups/
*.bak
*.backup
*.dump
*.sql.gz

# Logs
*.log
logs/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE configuration
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS files
Thumbs.db
desktop.ini